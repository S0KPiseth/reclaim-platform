# ==========================================
# Dependencies (Root, client/, and server/)
# ==========================================
node_modules/
client/node_modules/
server/node_modules/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
client/.env
server/.env
.env.local
.env.*.local
*.pem

# ==========================================
# Frontend & Backend Build Outputs
# ==========================================
client/dist/
client/build/
client/.vite/
server/dist/
server/build/
.cache/

# ==========================================
# Lost & Found Image Uploads (Inside server/)
# ==========================================
# Ignores test images uploaded locally while keeping the folder
server/uploads/*
server/public/uploads/*
!server/uploads/.gitkeep
!server/public/uploads/.gitkeep

# ==========================================
# Local Databases (If using SQLite)
# ==========================================
server/*.sqlite
server/*.sqlite3
server/*.db

# ==========================================
# Logs & Runtime Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & Code Editor Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
