# ==========================================
# Dependencies (Root, client/, and server/)
# ==========================================
node_modules/
client/node_modules/
server/node_modules/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
client/.env
server/.env
.env.local
.env.*.local
*.pem

# ==========================================
# Frontend & Backend Build Outputs
# ==========================================
client/dist/
client/build/
client/.vite/
server/dist/
server/build/
.cache/

# ==========================================
# Lost & Found Image Uploads (Inside server/)
# ==========================================
# Ignores test images uploaded locally while keeping the folder
server/uploads/*
server/public/uploads/*
!server/uploads/.gitkeep
!server/public/uploads/.gitkeep

# ==========================================
# Local Databases (If using SQLite)
# ==========================================
server/*.sqlite
server/*.sqlite3
server/*.db

# ==========================================
# Logs & Runtime Files
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# OS & Code Editor Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Embedding Service
# ==========================================
# The CLIP checkpoint is ~600 MB and is never committed. Put it in
# server/model (the service default) or point MODEL_DIR at it.
server/model/
server/model-*.zip
server/embedding-service/model/

# Service secrets
server/embedding-service/.env

# Python bytecode / venv from the embedding service
server/embedding-service/__pycache__/
*.py[cod]
server/embedding-service/.venv/
server/embedding-service/venv/
