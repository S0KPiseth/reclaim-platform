# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/reclaim?schema=public"

# Secret used to sign express-session cookies (use a long random string)
SESSION_SECRET="change-me-to-a-long-random-string"
# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# HTTP port
PORT=3445

# ---------------------------------------------------------------
# Embedding microservice (server/embedding-service)
# ---------------------------------------------------------------
# Leave EMBEDDING_URL empty to disable CLIP search entirely: the API then uses
# plain SQL keyword matching and never writes vectors.
EMBEDDING_URL="http://127.0.0.1:8000"
# Must equal EMBEDDING_API_KEY in server/embedding-service/.env
EMBEDDING_API_KEY=""
EMBEDDING_TIMEOUT_MS=15000
# Origin the Python service uses to fetch item photos (PUBLIC_BASE_URL default
# is http://127.0.0.1:PORT, which is fine for local dev).
# PUBLIC_BASE_URL="http://localhost:3445"
# Candidate pool for in-memory CLIP ranking. Raise only with pgvector.
SEARCH_CANDIDATE_CAP=2000
