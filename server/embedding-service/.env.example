# Folder containing the CLIP checkpoint (config.json, model.safetensors,
# tokenizer.json, preprocessor_config.json, vocab.json, merges.txt).
# Leave EMPTY to use server/model (the service default). Never hardcode the
# model into the repo or a Docker image - mount it instead.
MODEL_DIR=

# Label stored alongside every vector. Bump it whenever the model is retrained
# so old rows can be found and re-embedded.
MODEL_VERSION=v1

# Shared secret. If set, every request except /health needs X-API-Key.
EMBEDDING_API_KEY=

# Host/port for uvicorn (used by .bat/.sh launchers, not by the app itself)
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8000

# Limits
MAX_IMAGE_MB=10
MAX_BATCH=32
MAX_TEXTS=32
MAX_CANDIDATES=2000
