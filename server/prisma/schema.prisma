// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// passed to PrismaClient through a driver adapter (see src/db.js).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ItemStatus {
  OPEN
  CLAIMED
  RETURNED
  ARCHIVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items  Item[]  @relation("PostedItems")
  claims Claim[] @relation("UserClaims")
}

// Categories are free-form: the poster types a new one or picks an existing one.
// Item.category stores the display name; slug is a normalized key used for
// filtering/deduplication (see normalizeCategory() in src/lib/category.js).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  items Item[]
}

model Item {
  id            String     @id @default(cuid())
  title         String
  description   String
  status        ItemStatus @default(OPEN)
  foundLocation String
  foundAt       DateTime
  handoverNote  String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  posterId String
  poster   User        @relation("PostedItems", fields: [posterId], references: [id], onDelete: Cascade)
  images   ItemImage[]
  claims   Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([posterId])
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Claim {
  id         String      @id @default(cuid())
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimantId String
  claimant   User        @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Cascade)
  message    String
  status     ClaimStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([itemId, claimantId])
  @@index([claimantId])
  @@index([itemId, status])
}
