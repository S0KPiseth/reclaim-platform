// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// passed to PrismaClient through a driver adapter (see src/db.js).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ItemStatus {
  OPEN
  CLAIMED
  RETURNED
  ARCHIVED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items  Item[]  @relation("PostedItems")
  claims Claim[] @relation("UserClaims")
}

// Categories are free-form: the poster types a new one or picks an existing one.
// Item.category stores the display name; slug is a normalized key used for
// filtering/deduplication (see normalizeCategory() in src/lib/category.js).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  items Item[]
}

model Item {
  id            String     @id @default(cuid())
  title         String
  description   String
  status        ItemStatus @default(OPEN)
  foundLocation String
  foundAt       DateTime
  handoverNote  String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  posterId String
  poster   User        @relation("PostedItems", fields: [posterId], references: [id], onDelete: Cascade)
  images   ItemImage[]
  claims   Claim[]

  // CLIP search state. Kept in its own table so Item stays lean and vectors
  // can be re-embedded independently of item edits.
  embedding ItemEmbedding?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([posterId])
}

/// CLIP vectors for one item. Stored as Float[] (Postgres double precision[])
/// rather than pgvector so no extension is required; ranking happens in the
/// Python service. Only rows with the current modelVersion are comparable.
///
/// Two vectors are kept because CLIP's text-text and image-image similarities
/// live at different score scales. Querying text against item *text* vectors
/// scores consistently higher (~0.57) than a genuine text->photo match (~0.41),
/// so a single fused vector lets wordy text-only items drown out real photo
/// matches. Separating them means each search compares like with like:
///   textVector  - text→text semantic search
///   imageVector - text→image and image→image search
model ItemEmbedding {
  itemId         String   @id
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  textVector     Float[]
  imageVector    Float[]  // empty when the item has no photos
  modelVersion   String
  dim            Int      @default(512)
  hasPhotos      Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@index([modelVersion])
}

model ItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Claim {
  id         String      @id @default(cuid())
  itemId     String
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  claimantId String
  claimant   User        @relation("UserClaims", fields: [claimantId], references: [id], onDelete: Cascade)
  message    String
  status     ClaimStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([itemId, claimantId])
  @@index([claimantId])
  @@index([itemId, status])
}
